# Copy to .env for local Docker Compose. Cloud Run uses service environment
# variables (or Secret Manager), not this file.
POSTGRES_DB=trails
POSTGRES_USER=trails
POSTGRES_DB=trails
POSTGRES_USER=trails
POSTGRES_PASSWORD=replace-with-a-strong-password

# Local host port for http://localhost:8080
APP_PORT=8080

# Leave these commented for local Compose: it automatically connects the app
# to the db and garmin-service containers. Set them only to override defaults.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/trails
# SPRING_DATASOURCE_USERNAME=trails
APP_ENCRYPTION_KEY=replace-with-a-64-character-hexadecimal-key

