# Copy to .env for local Docker Compose.
# Compose uses the Supabase database configured here; it does not start a local Postgres container.

# Supabase/PostgreSQL connection details used by the app
DB_URL=jdbc:postgresql://YOUR-SUPABASE-HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR-SUPABASE-USERNAME
DB_PASSWORD=YOUR-SUPABASE-PASSWORD

# Local host port for http://localhost:8080
APP_PORT=8080

# AES-256 encryption key (64-character hexadecimal)
APP_ENCRYPTION_KEY=replace-with-a-64-character-hexadecimal-key

