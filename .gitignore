# IDEs
# ------------------------------
# VS Code
.vscode/
# If you want to keep workspace settings, uncomment the next line instead:
# !.vscode/settings.json

# IntelliJ
*.iml
.idea/
# Out folder for built-in compiler
out/

# Eclipse
.classpath
.project
.settings/

# ------------------------------
# OS / misc
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Python (garmin-service)
# ------------------------------
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
**/venv/
# Poetry/Pipenv environments if you use them
.venv/
pip-log.txt
poetry.lock

