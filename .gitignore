target/
!.mvn/wrapper/maven-wrapper.jar

# Maven build artifacts (sometimes)
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
release.properties

# Compiled class files
*.class

# ------------------------------
# Spring / application runtime
# ------------------------------
# Local environment files (keep .env.example)
.env
.env.*
!.env.example

# Crash dumps
hs_err_pid*

# ------------------------------
# Logs
# ------------------------------
*.log
logs/
**/logs/

